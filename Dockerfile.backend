FROM rust:1.83-slim-bookworm AS builder
WORKDIR /app
COPY backend/ .
RUN cargo build --release

FROM debian:bookworm-slim
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    python3 python3-pip python3-curl-cffi ca-certificates && \
    rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir yt-dlp[default] && \
    ln -s /usr/local/bin/yt-dlp /usr/bin/yt-dlp
COPY --from=builder /app/target/release/downloadanyvideo-backend /usr/local/bin/
EXPOSE 3001
CMD ["downloadanyvideo-backend"]
